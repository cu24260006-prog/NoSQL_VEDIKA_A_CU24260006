# Practical 1: Create Student table and insert five records.
# Run these commands in the HBase shell.

create 'Student', 'personal', 'academic'

put 'Student', 'S101', 'personal:name', 'Aarav Sharma'
put 'Student', 'S101', 'personal:city', 'Haridwar'
put 'Student', 'S101', 'academic:course', 'BCA'
put 'Student', 'S101', 'academic:semester', '3'

