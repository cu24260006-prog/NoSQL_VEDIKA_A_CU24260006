# Practical 2: CRUD operations on Employee table.

create 'Employee', 'personal', 'job'

# CREATE / INSERT
put 'Employee', 'E101', 'personal:name', 'Aarav Sharma'
put 'Employee', 'E101', 'personal:city', 'Haridwar'
put 'Employee', 'E101', 'job:department', 'IT'
put 'Employee', 'E101', 'job:salary', '35000'

put 'Employee', 'E102', 'personal:name', 'Diya Singh'
put 'Employee', 'E102', 'personal:city', 'Roorkee'
put 'Employee', 'E102', 'job:department', 'HR'
put 'Employee', 'E102', 'job:salary', '32000'

# READ one row
get 'Employee', 'E101'

# READ all rows
scan 'Employee'

# UPDATE a cell (put overwrites/adds the specified cell value)
put 'Employee', 'E101', 'job:salary', '40000'
get 'Employee', 'E101'

# DELETE one cell
delete 'Employee', 'E102', 'personal:city'
get 'Employee', 'E102'

# DELETE the complete E102 row
deleteall 'Employee', 'E102'
scan 'Employee'
